From fbc2849334265e24b3ad40b412c5cb26c821b9ff Mon Sep 17 00:00:00 2001
From: Chris Anderson <chris@raitechnology.com>
Date: Fri, 20 Nov 2026 14:34:26 -0800
Subject: [PATCH] gki_defconfig: the kernel options Droidspaces asks for

Compared with the option lists in Droidspaces' kernel guide, this kernel
had everything needed to start a container and lacked eleven options for
its extra features. Turn them on, so that Droidspaces-style containers
can be tried next to the AOHP env:

- DEVTMPFS: a container's init can fill its own /dev.
- IP6_NF_NAT, IP6_NF_TARGET_MASQUERADE: IPv6 NAT.
- NETFILTER_XT_TARGET_LOG, NETFILTER_XT_MATCH_RECENT, IP_SET,
  IP_SET_HASH_IP, IP_SET_HASH_NET, NETFILTER_XT_SET: UFW and fail2ban.
- TMPFS_POSIX_ACL (which selects TMPFS_XATTR): NixOS.

Nothing mounts devtmpfs by itself (DEVTMPFS_MOUNT stays off), so
Android's own /dev is unchanged.

The lines are placed where savedefconfig puts them. Not built yet.

Change-Id: I916fdd5dc7172d7a211f4c170d3fd89782d62697
---
 arch/arm64/configs/gki_defconfig | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/configs/gki_defconfig b/arch/arm64/configs/gki_defconfig
index 3f256bd31d1a..6db2779ea259 100644
--- a/arch/arm64/configs/gki_defconfig
+++ b/arch/arm64/configs/gki_defconfig
@@ -197,11 +197,13 @@ CONFIG_NFT_NAT=y
 CONFIG_NFT_REJECT=y
 CONFIG_NFT_COMPAT=y
 CONFIG_NFT_FIB_INET=y
+CONFIG_NETFILTER_XT_SET=y
 CONFIG_NETFILTER_XT_TARGET_CLASSIFY=y
 CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
 CONFIG_NETFILTER_XT_TARGET_CONNSECMARK=y
 CONFIG_NETFILTER_XT_TARGET_DSCP=y
 CONFIG_NETFILTER_XT_TARGET_IDLETIMER=y
+CONFIG_NETFILTER_XT_TARGET_LOG=y
 CONFIG_NETFILTER_XT_TARGET_MARK=y
 CONFIG_NETFILTER_XT_TARGET_NFLOG=y
 CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
@@ -235,12 +237,16 @@ CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
 CONFIG_NETFILTER_XT_MATCH_QUOTA=y
 CONFIG_NETFILTER_XT_MATCH_QUOTA2=y
 CONFIG_NETFILTER_XT_MATCH_QUOTA2_LOG=y
+CONFIG_NETFILTER_XT_MATCH_RECENT=y
 CONFIG_NETFILTER_XT_MATCH_SOCKET=y
 CONFIG_NETFILTER_XT_MATCH_STATE=y
 CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
 CONFIG_NETFILTER_XT_MATCH_STRING=y
 CONFIG_NETFILTER_XT_MATCH_TIME=y
 CONFIG_NETFILTER_XT_MATCH_U32=y
+CONFIG_IP_SET=y
+CONFIG_IP_SET_HASH_IP=y
+CONFIG_IP_SET_HASH_NET=y
 CONFIG_NFT_FIB_IPV4=y
 CONFIG_IP_NF_IPTABLES=y
 CONFIG_IP_NF_MATCH_ECN=y
@@ -264,6 +270,8 @@ CONFIG_IP6_NF_FILTER=y
 CONFIG_IP6_NF_TARGET_REJECT=y
 CONFIG_IP6_NF_MANGLE=y
 CONFIG_IP6_NF_RAW=y
+CONFIG_IP6_NF_NAT=y
+CONFIG_IP6_NF_TARGET_MASQUERADE=y
 CONFIG_TIPC=m
 CONFIG_L2TP=m
 CONFIG_BRIDGE=y
@@ -327,6 +335,7 @@ CONFIG_PCIE_DW_PLAT_EP=y
 CONFIG_PCIE_QCOM=y
 CONFIG_PCIE_KIRIN=y
 CONFIG_PCI_ENDPOINT=y
+CONFIG_DEVTMPFS=y
 CONFIG_FW_LOADER_USER_HELPER=y
 # CONFIG_FW_CACHE is not set
 # CONFIG_BRCMSTB_GISB_ARB is not set
@@ -666,6 +675,7 @@ CONFIG_MSDOS_FS=y
 CONFIG_VFAT_FS=y
 CONFIG_EXFAT_FS=y
 CONFIG_TMPFS=y
+CONFIG_TMPFS_POSIX_ACL=y
 # CONFIG_EFIVAR_FS is not set
 CONFIG_PSTORE=y
 CONFIG_PSTORE_CONSOLE=y
